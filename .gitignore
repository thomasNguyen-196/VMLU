# VMLU dataset folders (kept in vmlu_datasets.zip on remote)
vmlu_dialog_v1/
vmlu_drop_v1/
vmlu_mqa_v1.5/
vmlu_squad_v1/

# V-Bench: official sample + generated submissions (regenerable artifacts).
# data/example_submission.csv is the tracked VMLU upload template — don't ignore it.
v_bench/
/submissions/

# SEATauBench vendor (telecom EN+VI + smoke log; re-fetchable from SEACrowd/SEATauBench @ 312f3e6).
# The pre-register manifest seatau_bench/manifest_*.json stays tracked.
seatau_bench/telecom/
seatau_bench/telecom_tasks_*.json
seatau_bench/smoke_*.json
seatau_bench/split_tasks.json
# Independent Vietnamese legal benchmarks (HF downloads; re-fetchable, hashes in its README)
# VLSP2025-LegalSML/Public-Test + ntphuc149/ViBidLQA_v1
v_legal_slsp/

# Vietnamese medical MCQ benchmark (HF download venera-ai/VietnameseMedBench, re-fetchable;
# hashes/quirks in v_med_vm14k/README.md)
v_med_vm14k/

# Annotation workbooks (local human artifacts; the filled manifest is the committed record)
annotation_workbooks/
# Derived gold files (regenerated by export_annotation_workbooks from review_records/)
/data/gold/
# Root-level artifacts (review_records/*.csv must stay tracked — the split-400 sync log)
/review_ui.html
# Harness-arm offline report (generated by build_dashboard_harness.py; the block in
# web/public/benchmark-data.json is the tracked surface)
/harness_report.html
/state_*.json
# Review-server state buckets (per reviewer×model JSON; the export CSVs above are the record)
review_state/
# Contract-test scratch file for the Next app (written by TestNextContracts)
web/.contract-test.ts
# Generated report artifacts (dated HTML/PDF renders via tools/html2pdf_server.py)
/report/
/benchmark_dashboard.html
# Isolated omp agent dir for the harness arm (provider config + IEC token)
.omp-iec/

# Scaffold capture dir (localhost proxy target) — instrumentation only
.omp-capture/

# Clean-scaffold probe dir (APPEND_SYSTEM shadowing test)
.omp-clean/

# MiMo harness arm (opencode zen go) — agent dir for the model replication
.omp-mimo/

# Capture-only agent dir for the MiMo scaffold capture
.omp-mimo-cap/

# Measured MiMo agent dir whose provider points at the localhost pinning proxy
.omp-mimo-pinned/
