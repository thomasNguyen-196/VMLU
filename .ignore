# Secret-bearing environment files. Keep templates readable.
/.env
/.env.*
!/.env.example
!/.env.template
!/.env.sample

# Large benchmark data & dataset folders
vmlu/**
/vmlu_v*/**
/datasets/**
# data/: tracked contracts (manifest, dataset_stat, example_submission) stay searchable;
# hide the bulky/derived artifacts only
/data/sample_submission.jsonl
/data/submission*.csv
/data/submission*.jsonl
/data/gold_agreed.csv
/data/adjudication.csv
/data/review_gold_agreed.csv
/data/review_adjudication.csv

# Benchmark outputs, logs, and evaluation dumps
/logs/**
/code_benchmark/all_res/**
/code_benchmark/logs/**
/code_benchmark/submission.csv
/leaderboard.json

# Python & Notebook cache/artifacts
/__pycache__/**
*.pyc
*.pyo
.ipynb_checkpoints/**
.pytest_cache/**
