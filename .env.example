# API credentials and endpoint configuration
# For Ollama OpenAI-compatible endpoint, point to the /v1 path (e.g. http://localhost:11434/v1 or university proxy endpoint)
OPENAI_BASE_URL="http://localhost:11434/v1"
# API Key for Ollama or OpenAI compatible gateway (can be a dummy string like 'ollama' if unauthorized)
OPENAI_API_KEY="ollama"
# Target model tag or name (e.g. llama3:8b, qwen2.5:7b, gpt-4o-mini)
OPENAI_MODEL="llama3:8b"

# Vietnamese multi-model benchmark v1 uses OpenCode Go for Muse/MiMo.
# The runner also reads an existing OpenCode credential from
# ~/.local/share/opencode/auth.json (provider: opencode-go); setting the key here
# is optional. These rates are subscription-usage equivalents, not per-request charges.
OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"
OPENCODE_GO_API_KEY=""

# --- Lab PC docker-compose deployment (docker-compose.yml at repo root) ---
# Host bind addresses; defaults keep everything loopback-only on the PC.
# VMLU_WEB_BIND="127.0.0.1"
# Public HTTPS entrypoint via ngrok (used only with `--profile public`).
# NGROK_DOMAIN="your-name.ngrok-free.app"
# NGROK_AUTH_TOKEN="ngrok authtoken from dashboard.ngrok.com"
# SSH target of tools/push_data_to_pc.py (key-based; the PC is on the tailnet).
# VMLU_PC_SSH="user@pc-hostname"
